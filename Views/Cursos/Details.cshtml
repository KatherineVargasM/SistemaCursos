@model SistemaCursos.Models.CursoModel

@{
    ViewData["Title"] = "Detalles del Curso";
}

<h1 class="display-5 mt-4 mb-3" style="font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; color: #2b303a; font-weight: 300; letter-spacing: -0.5px;">
    Detalles del Curso
</h1>

<hr style="border-color: #51b5ae; opacity: 0.2;" />

<div class="mt-4" style="font-family: 'Segoe UI', sans-serif; max-width: 700px;">

    <div class="row py-2" style="border-bottom: 1px solid #dee2e6;">
        <div class="col-sm-4" style="font-weight: 600; color: #495057;">
            ID
        </div>
        <div class="col-sm-8" style="font-weight: bold; color: #212529;">
            @Model.curso_id
        </div>
    </div>

    <div class="row py-2" style="border-bottom: 1px solid #dee2e6;">
        <div class="col-sm-4" style="font-weight: 600; color: #495057;">
            Nombre del Curso
        </div>
        <div class="col-sm-8">
            @Model.nombre
        </div>
    </div>

    <div class="row py-2" style="border-bottom: 1px solid #dee2e6;">
        <div class="col-sm-4" style="font-weight: 600; color: #495057;">
            Descripción
        </div>
        <div class="col-sm-8">
            @Model.descripcion
        </div>
    </div>

    <div class="row py-2" style="border-bottom: 1px solid #dee2e6;">
        <div class="col-sm-4" style="font-weight: 600; color: #495057;">
            Fecha de Inicio
        </div>
        <div class="col-sm-8">
            @Model.fecha_inicio.ToShortDateString()
        </div>
    </div>

    <div class="row py-2" style="border-bottom: 1px solid #dee2e6;">
        <div class="col-sm-4" style="font-weight: 600; color: #495057;">
            Fecha de Finalización
        </div>
        <div class="col-sm-8">
            @Model.fecha_fin.ToShortDateString()
        </div>
    </div>

</div>

<div class="mt-4 mb-5" style="font-family: 'Segoe UI', sans-serif;">

    <a asp-action="Edit"
       asp-route-id="@Model.curso_id"
       class="btn"
       style="background-color: #ffe8d6; color: #a75d00; font-weight: 500; border: 1px solid #ffdad6; border-radius: 6px; padding: 8px 24px; margin-right: 8px;">
        Editar
    </a>

    <a asp-action="Index"
       class="btn"
       style="background-color: #e9ecef; color: #495057; font-weight: 500; padding: 8px 24px; border-radius: 6px; border: 1px solid #dee2e6;">
        Regresar
    </a>

</div>