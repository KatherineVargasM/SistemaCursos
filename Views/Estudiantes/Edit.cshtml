@model SistemaCursos.Models.EstudianteModel

@{
    ViewData["Title"] = "Editar Estudiante";
}

<h1 class="display-5 mt-4 mb-3"
    style="font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; color: #2b303a; font-weight: 300; letter-spacing: -0.5px;">
    Editar Estudiante
</h1>

<hr style="border-color: #51b5ae; opacity: 0.2;" />

<div class="row mt-4" style="font-family: 'Segoe UI', sans-serif;">
    <div class="col-md-6">

        <form asp-action="Edit">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="estudiante_id" />

            <div class="form-group mb-3">
                <label asp-for="nombre"
                       class="control-label"
                       style="font-weight: 500; color: #495057;">
                </label>

                <input asp-for="nombre"
                       class="form-control"
                       style="border-radius: 6px; border: 1px solid #ced4da;" />

                <span asp-validation-for="nombre" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="apellido"
                       class="control-label"
                       style="font-weight: 500; color: #495057;">
                </label>

                <input asp-for="apellido"
                       class="form-control"
                       style="border-radius: 6px; border: 1px solid #ced4da;" />

                <span asp-validation-for="apellido" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="email"
                       class="control-label"
                       style="font-weight: 500; color: #495057;">
                </label>

                <input asp-for="email"
                       class="form-control"
                       style="border-radius: 6px; border: 1px solid #ced4da;" />

                <span asp-validation-for="email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="fecha_nacimiento"
                       class="control-label"
                       style="font-weight: 500; color: #495057;">
                </label>

                <input asp-for="fecha_nacimiento"
                       class="form-control"
                       style="border-radius: 6px; border: 1px solid #ced4da;" />

                <span asp-validation-for="fecha_nacimiento" class="text-danger"></span>
            </div>

            <div class="form-group mt-4 mb-5">
                <input type="submit"
                       value="Guardar Cambios"
                       class="btn text-white"
                       style="background-color: #51b5ae; font-weight: 500; padding: 8px 24px; border-radius: 6px; border: none; margin-right: 8px;" />

                <a asp-action="Index"
                   class="btn"
                   style="background-color: #e9ecef; color: #495057; font-weight: 500; padding: 8px 24px; border-radius: 6px; border: 1px solid #dee2e6;">
                    Regresar
                </a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}