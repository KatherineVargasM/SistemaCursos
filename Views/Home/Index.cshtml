@{
    ViewData["Title"] = "Inicio";
}

<div class="container d-flex flex-column align-items-center justify-content-center" style="font-family: 'Segoe UI', sans-serif; min-height: 70vh; text-align: center;">

    <h1 class="display-5 mb-4" style="font-weight: 300; color: #2b303a; letter-spacing: -0.5px;">
        Sistema de Gestión de Cursos
    </h1>

    <div class="mb-4 mt-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" fill="#5dc1b9" class="bi bi-mortarboard" viewBox="0 0 16 16" style="opacity: 0.85;">
            <path d="M8.156 1.812a1.5 1.5 0 0 0-1.312 0l-5.851 2.805A.5.5 0 0 0 0 5.071V10a.5.5 0 0 0 .287.452l3.1 1.55A1.5 1.5 0 0 0 4 12.5v1.5a.5.5 0 0 0 .5.5h7a.5.5 0 0 0 .5-.5v-1.5a1.5 1.5 0 0 0 .613-.5l3.1-1.55A.5.5 0 0 0 16 10V5.071a.5.5 0 0 0-.293-.454zM1.2 5.071l6.146-2.946a.5.5 0 0 1 .438 0l6.146 2.946-6.146 2.946a.5.5 0 0 1-.438 0zM3 10l-.001-4.218 5 2.398 5-2.398V10l-4.713 2.356a.5.5 0 0 1-.444 0zM4 12.5v1h8v-1c0-.276-.224-.5-.5-.5h-7c-.276 0-.5.224-.5.5" />
        </svg>
    </div>

    <div class="mt-3 d-flex flex-wrap justify-content-center">
        <a asp-controller="Cursos" asp-action="Index" class="btn text-white mx-2 my-1" style="background-color: #5dc1b9; font-weight: 500; padding: 10px 35px; border-radius: 6px; box-shadow: 0 4px 10px rgba(93, 193, 185, 0.15); border: none; font-size: 1.05rem;">
            Cursos
        </a>
        <a asp-controller="Estudiantes" asp-action="Index" class="btn text-white mx-2 my-1" style="background-color: #5dc1b9; font-weight: 500; padding: 10px 35px; border-radius: 6px; box-shadow: 0 4px 10px rgba(93, 193, 185, 0.15); border: none; font-size: 1.05rem;">
            Estudiantes
        </a>
        <a asp-controller="Inscripciones" asp-action="Index" class="btn text-white mx-2 my-1" style="background-color: #5dc1b9; font-weight: 500; padding: 10px 35px; border-radius: 6px; box-shadow: 0 4px 10px rgba(93, 193, 185, 0.15); border: none; font-size: 1.05rem;">
            Inscripciones
        </a>
    </div>

</div>