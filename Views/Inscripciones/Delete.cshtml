@model SistemaCursos.Models.InscripcionModel

@{
    ViewData["Title"] = "Eliminar Inscripción";
}

<h1>Eliminar</h1>

<h3>¿Estás seguro de que deseas eliminar esto?</h3>
<div>
    <h4>Inscripción</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Curso)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Curso.nombre)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Estudiante)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Estudiante.nombre) @Html.DisplayFor(model => model.Estudiante.apellido)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.fecha_inscripcion)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.fecha_inscripcion)
        </dd>
    </dl>

    <form asp-action="Delete" class="mt-4">
        <input type="hidden" asp-for="inscripcion_id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index">Volver a la lista</a>
    </form>
</div>